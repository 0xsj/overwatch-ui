# overwatch-ui — every key this tree needs, per decisions/0001.
#
# The root Makefile exports the workspace .env into this child, so running
# `make dev` from the workspace root supplies all of it. This file exists so a
# standalone clone knows what to supply WITHOUT reading the parent, and so
# `make dev` from inside this directory works on its own.
#
# Copy to .env.local (git-ignored, and what Next reads first).

# Where the server is. The /v1 belongs here rather than in fourteen service
# paths — lib/services asks for `/register`, not `/v1/register`.
#
# UNSET IS A SUPPORTED MODE, not a missing value: lib/root picks the in-memory
# adapter and the whole client runs on fixtures, with a `mock` badge on every
# screen that shows one. The startup banner says which it chose.
NEXT_PUBLIC_API_URL=http://localhost:7002/v1
